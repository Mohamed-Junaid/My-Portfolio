# Remote toggle for the profile photo (Firestore).
# Copy this file to `.env.local` and fill in your Firebase web app values.
# These are PUBLIC values (embedded in the browser) — not secrets.
# Find them in: Firebase Console → Project settings → Your apps → Web app → SDK config.

NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_API_KEY=your-web-api-key
